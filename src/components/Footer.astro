---
import { SITE, bookingHref } from '../consts';
---
<footer class="site-foot on-blue">
  <div class="foot-inner">
    <div class="foot-top">
      <div class="foot-col">
        <p class="foot-k">Contact</p>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <a href={bookingHref}>Réserver un appel</a>
      </div>
      <div class="foot-col">
        <p class="foot-k">Site</p>
        <a href="/#histoire">Comment ça marche</a>
        <a href="/#offre">L'offre</a>
        <a href="/blogue/">Blogue</a>
      </div>
      <div class="foot-col">
        <p class="foot-k">Légal</p>
        <a href="/politique-de-confidentialite/">Politique de confidentialité</a>
        <a href="/mentions-legales/">Mentions légales</a>
        {SITE.linkedin && <a href={SITE.linkedin} rel="me">LinkedIn</a>}
      </div>
    </div>
    <p class="foot-word" aria-hidden="true">AxioPilot</p>
    <div class="foot-bottom"><span>© {new Date().getFullYear()} AxioPilot</span><span>Automatiser · Simplifier · Accélérer</span></div>
  </div>
</footer>
