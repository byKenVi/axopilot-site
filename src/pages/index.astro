---
import Base from '../layouts/Base.astro';
import Doodle from '../components/Doodle.astro';
import { bookingHref } from '../consts';
import { getPosts } from '../lib';
import '../styles/home.css';

const posts = (await getPosts()).slice(0, 3);

const tools = ['HubSpot', 'Pipedrive', 'Make', 'n8n', 'Zapier', 'Google Workspace', 'Microsoft 365', 'Slack', 'Asana', 'ClickUp', 'Monday', 'Notion', 'GA4', 'Google Ads', 'Meta Ads', 'Looker Studio', 'QuickBooks', 'PandaDoc'];

const UI: Record<string, string> = {
  signature: `
    <div class="ui-event"><span class="ui-badge">Déclencheur</span><b>Contrat signé</b><small>Agence Boréal × Clinique Dentaire Laval · PandaDoc</small></div>
    <div class="ui-wait"><span class="spin"></span>AxioPilot prend le relais…</div>`,
  accueil: `
    <ul class="ui-log">
      <li><span>9:02:06</span>Fiche client créée dans HubSpot<i>✓</i></li>
      <li><span>9:02:14</span>Dossier Drive « Clinique Dentaire Laval »<i>✓</i></li>
      <li><span>9:02:19</span>Projet Asana copié du gabarit<i>✓</i></li>
      <li><span>9:02:29</span>Courriel de bienvenue + questionnaire<i>✓</i></li>
      <li><span>9:02:41</span>Message dans #nouveaux-clients<i>✓</i></li>
    </ul>`,
  rapport: `
    <div class="ui-report">
      <div class="ui-report-h"><b>Rapport d'octobre</b><span>Clinique Dentaire Laval</span></div>
      <div class="ui-kpis"><div><small>Clics</small><b>4 812</b><em>+18 %</em></div><div><small>Conversions</small><b>137</b><em>+22 %</em></div><div><small>Coût / conv.</small><b>21,40 $</b><em>−9 %</em></div></div>
      <svg viewBox="0 0 300 80" preserveAspectRatio="none" class="ui-spark"><polyline vector-effect="non-scaling-stroke" points="0,62 30,58 60,60 90,48 120,50 150,38 180,40 210,28 240,30 270,16 300,12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>`,
  soumission: `
    <div class="ui-quote">
      <div class="ui-quote-h"><b>Soumission #2026-114</b><span class="ui-badge ok">Envoyée 14 h 14</span></div>
      <div class="ui-row"><span>Refonte du site Web</span><span>✓</span></div>
      <div class="ui-row"><span>SEO local · 3 mois</span><span>✓</span></div>
      <div class="ui-row"><span>Campagne Google Ads</span><span>✓</span></div>
      <div class="ui-src">Source : formulaire du site · qualifiée « budget confirmé »</div>
    </div>`,
};

const steps = [
  { id: 'signature', label: 'Signature', time: 'Lundi · 9 h 02', title: 'Agence Boréal signe un nouveau client.', text: "Le contrat arrive signé. Personne n'a encore touché à rien, et c'est voulu.", gain: 'Le déclencheur', saved: 0, before: ['Repérer le contrat dans les courriels', "Prévenir l'équipe à la main"], cta: "Automatiser l'accueil client" },
  { id: 'accueil', label: 'Accueil client', time: 'Lundi · 9 h 02 min 41 s', title: '41 secondes plus tard, tout est prêt.', text: "Fiche CRM, dossier partagé, projet, courriel de bienvenue, avis à l'équipe. Sans oubli, sans relance.", gain: '≈ 2 h de saisie évitées', saved: 2, before: ['Créer la fiche CRM', 'Monter le dossier partagé', 'Copier le projet du gabarit', 'Écrire le courriel de bienvenue'], cta: "Automatiser l'accueil client" },
  { id: 'rapport', label: 'Rapport mensuel', time: '1er du mois · 7 h 00', title: 'Les rapports clients sont déjà prêts.', text: "Google Ads, GA4 et Meta réunis dans un rapport à vos couleurs. Il ne reste qu'à relire et envoyer.", gain: '≈ 4 h par client, chaque mois', saved: 6, before: ['Exporter Google Ads, GA4 et Meta', 'Copier-coller dans le gabarit', 'Mettre en forme, vérifier les chiffres'], cta: 'Automatiser mes rapports' },
  { id: 'soumission', label: 'Soumission', time: 'Mardi · 14 h 10', title: 'Une demande arrive à 14\u00a0h\u00a010. Elle repart à 14\u00a0h\u00a014.', text: 'La demande est captée, qualifiée et transformée en brouillon de soumission. Vous validez, le prospect a sa réponse le jour même.', gain: 'Réponse en 4 min au lieu de 48 h', saved: 7.5, before: ['Lire la demande… deux jours après', 'Monter la soumission à la main'], cta: 'Automatiser mes soumissions' },
];

const phases = [
  ['Jours 1 à 3', 'Diagnostic', "Un atelier de 90 minutes avec votre équipe. On cartographie le processus et on mesure le temps perdu."],
  ['Jours 4 à 17', 'Construction', "On bâtit l'automatisation sur vos outils et on la teste avec de vrais cas. Un point d'étape par semaine."],
  ['Jours 18 à 21', 'Mise en service', 'Lancement, formation de votre équipe et documentation en français.'],
  ['Mois 1 à 3', 'Suivi', 'Surveillance, ajustements et un bilan mensuel des heures récupérées.'],
];

const faqs = [
  ['Faut-il changer nos outils ?', "Non. On travaille avec ce que vous utilisez déjà : HubSpot, Pipedrive, Asana, ClickUp, Monday, Google Workspace, Microsoft 365, Slack et la plupart des outils courants en agence."],
  ["Qu'arrive-t-il aux données de nos clients ?", "Les données restent dans vos comptes. On documente chaque flux de renseignements personnels pour vous aider à respecter la Loi 25, et les accès sont retirés à la fin du mandat si vous le souhaitez."],
  ["Et si l'automatisation brise ?", "Les 3 mois de suivi sont faits pour ça : surveillance des erreurs, alertes et corrections. Votre équipe reçoit aussi une documentation simple pour comprendre ce qui roule."],
  ['Combien ça coûte ?', "Le Pack Sprint + Suivi est offert à prix fixe. On vous le confirme au premier appel, après avoir vu le processus à automatiser."],
  ['Vous faites aussi des sites et des interfaces ?', "Oui. Ce site en est un exemple. On conçoit aussi des portails clients, des tableaux de bord et des interfaces internes quand l'automatisation en a besoin."],
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
---
<Base jsonLd={faqLd}>

  <!-- ========== HERO ========== -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-stage" aria-hidden="true">
      <canvas id="hero3d"></canvas>
      <img class="hero-fallback" src="/logo-mark-color.png" alt="" width="222" height="154">
      <p class="hand hero-note">vos tâches, en route<Doodle name="curl" class="note-curl" /></p>
    </div>
    <Doodle name="star" class="float d-hero-star" />
    <Doodle name="spiral" class="float d-hero-spiral" />
    <div class="container hero-inner">
      <h1 id="hero-title" class="display">
        <span class="w">Votre</span> <span class="w">agence,</span><br>
        <span class="w">en</span> <span class="w hl">pilote<Doodle name="underline" class="hl-line" /></span><br>
        <span class="w">automatique.</span>
      </h1>
      <div class="hero-bottom">
        <p class="hero-lead">On automatise l'accueil des clients, les rapports et les soumissions des agences du Québec. <strong>Livré en 21 jours</strong>, sur les outils que vous utilisez déjà.</p>
        <div class="hero-ctas">
          <a class="btn btn-primary btn-lg" href={bookingHref}>Réserver un appel de 30 min <span class="arr" aria-hidden="true">→</span></a>
          <a class="btn btn-ghost btn-lg" href="#histoire">Voir comment ça marche</a>
        </div>
      </div>
      <ul class="hero-proof">
        <li><b>21 jours</b> pour livrer</li>
        <li><b>Prix fixe</b> annoncé dès l'appel</li>
        <li><b>3 mois</b> de suivi inclus</li>
      </ul>
    </div>
  </section>

  <!-- ========== Outils ========== -->
  <section class="tools" aria-label="Outils compatibles">
    <div class="tools-row"><div class="tools-track">{[...tools, ...tools].map((t) => <span>{t}</span>)}</div></div>
  </section>

  <!-- ========== Énoncé ========== -->
  <section class="statement container">
    <Doodle name="loop" class="d-statement" />
    <p class="big-text reveal-words">Vos meilleurs talents passent des heures à créer des dossiers, assembler des rapports et relancer des clients. <span class="soft">On rend ces heures à votre équipe, pour qu'elle les passe sur ce qui fait grandir l'agence.</span></p>
    <a class="btn btn-primary" href={bookingHref}>Voir ce qu'on peut automatiser chez vous <span class="arr" aria-hidden="true">→</span></a>
  </section>

  <!-- ========== Histoire ========== -->
  <section class="story" id="histoire" aria-labelledby="story-title">
    <div class="container story-head rv">
      <p class="pill">Comment ça marche</p>
      <h2 id="story-title" class="h2">Une semaine chez Agence Boréal, <span class="hand-hl">en pilote automatique</span>.</h2>
      <p class="note">Agence fictive, scénario réel : c'est exactement ce qu'on met en place chez nos clients.</p>
    </div>

    <div class="story-pin" style={`--n:${steps.length}`}>
      <div class="story-stage">
        <div class="container">
          <div class="story-top">
            <ol class="tabs" style={`--n:${steps.length}`}>
              {steps.map((s, i) => (
                <li class={i === 0 ? 'is-active' : ''} data-i={i}>
                  <button type="button" class="tab" data-go={i}><span class="tab-n">{String(i + 1).padStart(2, '0')}</span><span class="tab-l">{s.label}</span><span class="tab-bar"><i></i></span></button>
                </li>
              ))}
            </ol>
            <div class="counter" aria-live="polite"><span class="counter-k">Temps rendu à l'équipe</span><b id="saved">0 h</b></div>
          </div>
          <div class="stage-grid">
            <div class="chapters">
              {steps.map((s, i) => (
                <article class={`chapter${i === 0 ? ' is-active' : ''}`} data-ch={i}>
                  <div class="ch-head"><span class="ch-num">{String(i + 1).padStart(2, '0')}</span><span class="ch-time">{s.time}</span></div>
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                  <div class="ch-before"><span class="ch-before-k">Avant :</span><ul>{s.before.map((b, k) => <li style={`--k:${k}`}><span>{b}</span></li>)}</ul></div>
                  <div class="ch-foot"><span class="ch-gain">{s.gain}</span><a class="link-cta" href={bookingHref} tabindex={i === 0 ? undefined : -1}>{s.cta} <span aria-hidden="true">→</span></a></div>
                </article>
              ))}
            </div>
            <div class="stage-right" aria-hidden="true">
              <Doodle name="arrow" class="d-stage-arrow" />
              <p class="hand stage-hand">avec AxioPilot</p>
              <div class="window">
                <div class="window-bar"><i></i><i></i><i></i><span>AxioPilot · journal d'exécution</span></div>
                <div class="window-body">
                  {steps.map((s, i) => (<div class={`ui-slot${i === 0 ? ' is-active' : ''}`} data-slot={i}><Fragment set:html={UI[s.id]} /></div>))}
                </div>
                <div class="window-foot"><span>Gain</span><b id="gain">{steps[0].gain}</b></div>
              </div>
            </div>
          </div>
        </div>
        <a class="story-skip" href="#suite">Passer l'histoire <span aria-hidden="true">↓</span></a>
      </div>
    </div>

    <!-- Mobile : cartes à faire glisser -->
    <div class="story-swipe">
      <p class="swipe-hint" aria-hidden="true">glissez pour suivre la semaine →</p>
      <ol class="swipe-track" id="swipe" aria-label="Les quatre étapes">
        {steps.map((s, i) => (
          <li class={`swipe-card${i === 0 ? ' is-active' : ''}`} aria-label={`Étape ${i + 1} sur ${steps.length}`}>
            <div class="ch-head"><span class="ch-num">{String(i + 1).padStart(2, '0')}</span><span class="ch-time">{s.time}</span></div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <div class="ch-before"><span class="ch-before-k">Avant :</span><ul>{s.before.map((b, k) => <li style={`--k:${k}`}><span>{b}</span></li>)}</ul></div>
            <div class="window"><div class="window-bar"><i></i><i></i><i></i><span>Avec AxioPilot</span></div><div class="window-body static"><Fragment set:html={UI[s.id]} /></div><div class="window-foot"><span>Gain</span><b>{s.gain}</b></div></div>
          </li>
        ))}
      </ol>
      <div class="swipe-nav">
        <div class="dots">{steps.map((s, i) => <button type="button" class={i === 0 ? 'is-active' : ''} data-dot={i} aria-label={`Aller à l'étape ${i + 1} : ${s.label}`}></button>)}</div>
        <div class="swipe-arrows"><button type="button" id="swPrev" aria-label="Étape précédente" disabled>←</button><button type="button" id="swNext" aria-label="Étape suivante">→</button></div>
      </div>
    </div>

    <div class="container" id="suite">
      <div class="story-cta rv">
        <Doodle name="check" class="d-check" />
        <p><b>Ça ressemble à la semaine de votre agence ?</b> On regarde ensemble ce qui peut rouler tout seul chez vous.</p>
        <a class="btn btn-primary btn-lg" href={bookingHref}>Réserver un appel <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- ========== Offre ========== -->
  <section class="offer on-blue" id="offre" aria-labelledby="offer-title">
    <Doodle name="gear" class="float d-offer-gear" />
    <Doodle name="bolt" class="float d-offer-bolt" />
    <div class="container">
      <p class="pill">L'offre · Pack Sprint + Suivi</p>
      <h2 id="offer-title" class="display-2 rv">21 jours pour livrer.<br><span class="soft">3 mois pour que ça dure.</span></h2>
      <ol class="phases">
        {phases.map(([when, title, text], i) => (
          <li class="rv" style={`--d:${i}`}><span class="ph-num">{i + 1}</span><span class="ph-when">{when}</span><h3>{title}</h3><p>{text}</p></li>
        ))}
      </ol>
      <div class="offer-foot">
        <p><b>Un prix fixe, confirmé dès le premier appel.</b> Pas de facturation à l'heure, pas de surprise.</p>
        <a class="btn btn-primary btn-lg" href={bookingHref}>Parler de votre processus <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- ========== Calculateur (section blanche) ========== -->
  <section class="calc container" aria-labelledby="calc-title">
    <div class="calc-card rv">
      <p class="pill">Faites le calcul</p>
      <h2 id="calc-title" class="sr-only">Combien vous coûtent les tâches répétitives</h2>
      <form class="madlib" onsubmit="return false">
        <p>
          Notre équipe passe
          <label class="fieldwrap"><span class="sr-only">Heures par semaine</span><button type="button" class="step" data-t="h" data-d="-1" aria-label="Moins une heure">−</button><input id="h" type="number" inputmode="numeric" min="1" max="80" value="8"><span>h</span><button type="button" class="step" data-t="h" data-d="1" aria-label="Plus une heure">+</button></label>
          par semaine sur des tâches répétitives, à
          <label class="fieldwrap"><span class="sr-only">Coût horaire</span><button type="button" class="step" data-t="r" data-d="-5" aria-label="Moins 5 dollars">−</button><input id="r" type="number" inputmode="numeric" min="15" max="250" step="5" value="55"><span>$</span><button type="button" class="step" data-t="r" data-d="5" aria-label="Plus 5 dollars">+</button></label>
          de l'heure.
        </p>
      </form>
      <div class="calc-result" aria-live="polite">
        <div>
          <span class="calc-k">Ce que ça vous coûte par année</span>
          <span class="calc-num" id="out">22 880 $</span>
          <span class="calc-sub" id="out2">En automatisant 60 %, vous récupérez environ 250 heures et 13 728 $.</span>
        </div>
        <a class="btn btn-primary btn-lg" href={bookingHref}>Récupérer ces heures <span class="arr" aria-hidden="true">→</span></a>
      </div>
      <Doodle name="circle" class="d-calc-circle" />
    </div>
  </section>

  <!-- ========== Principes ========== -->
  <section class="principles container" aria-label="Notre façon de travailler">
    <div class="rv"><Doodle name="gear" class="p-icon" /><h3>Vos outils, pas les nôtres.</h3><p>On construit sur ce que votre équipe connaît déjà. Pas de nouveau logiciel à apprendre.</p></div>
    <div class="rv" style="--d:1"><Doodle name="mail" class="p-icon" /><h3>Un seul interlocuteur.</h3><p>Vous parlez toujours à la personne qui construit, du diagnostic au suivi.</p></div>
    <div class="rv" style="--d:2"><Doodle name="check" class="p-icon" /><h3>En français, conforme Loi 25.</h3><p>Documentation, formation et suivi en français, aux heures de l'Est.</p></div>
  </section>

  {posts.length > 0 && (
  <section class="journal container" id="blogue">
    <div class="journal-head"><p class="pill">Blogue</p><a class="link-cta" href="/blogue/">Tous les articles <span aria-hidden="true">→</span></a></div>
    <ul class="journal-list">
      {posts.map((p) => (
        <li><a href={`/blogue/${p.id}/`}><span class="j-cat">{p.data.category}</span><span class="j-title">{p.data.title}</span><span class="j-arrow" aria-hidden="true">→</span></a></li>
      ))}
    </ul>
  </section>
  )}

  <!-- ========== FAQ ========== -->
  <section class="faq2 container" id="faq" aria-labelledby="faq-title">
    <div>
      <h2 id="faq-title" class="h2">Questions fréquentes</h2>
      <p class="faq-more">Une autre question ? Le plus simple, c'est d'en parler 30 minutes.</p>
      <a class="btn btn-primary" href={bookingHref}>Réserver un appel <span class="arr" aria-hidden="true">→</span></a>
    </div>
    <div class="faq-list">
      {faqs.map(([q, a]) => (<details><summary>{q}</summary><p>{a}</p></details>))}
    </div>
  </section>

  <!-- ========== CTA final ========== -->
  <section class="cta-end on-blue" id="rdv">
    <Doodle name="star" class="float d-end-star" />
    <Doodle name="spiral" class="float d-end-spiral" />
    <Doodle name="bolt" class="float d-end-bolt" />
    <div class="container">
      <p class="hand cta-hand">c'est le moment</p>
      <h2 class="display-2">Trouvons les heures que votre agence perd.</h2>
      <p class="cta-lead">Un appel de 30 minutes, sans engagement. Vous repartez avec au moins une idée d'automatisation applicable, même si on ne travaille pas ensemble.</p>
      <a class="btn btn-primary btn-xl" href={bookingHref}>Choisir un moment <span class="arr" aria-hidden="true">→</span></a>
    </div>
  </section>

  <div class="read-progress" id="readProgress" aria-hidden="true"></div>

  <!-- Barre d'action mobile -->
  <div class="mobile-cta" id="mobileCta"><span>Appel découverte · 30 min</span><a class="btn btn-primary" href={bookingHref}>Réserver</a></div>
</Base>

<script>
  import Lenis from 'lenis';
  import { initHero3D } from '../scripts/hero3d';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fmt = (n: number) => Math.round(n).toLocaleString('fr-CA');
  let lenis: Lenis | null = null;

  if (!reduce) {
    lenis = new Lenis({ lerp: 0.12, wheelMultiplier: 0.95, touchMultiplier: 1 });
    const raf = (t: number) => { lenis!.raf(t); requestAnimationFrame(raf); };
    requestAnimationFrame(raf);
  }
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"], a[href^="/#"]').forEach((a) => {
    a.addEventListener('click', (e) => {
      const id = a.getAttribute('href')!.replace('/', '');
      const el = document.querySelector<HTMLElement>(id);
      if (el && location.pathname === '/' && lenis) { e.preventDefault(); lenis.scrollTo(el, { offset: -72, duration: 1.1 }); history.replaceState(null, '', id); }
    });
  });

  /* 3D */
  const cv = document.getElementById('hero3d') as HTMLCanvasElement;
  if (cv && initHero3D(cv, { reduce })) document.querySelector('.hero')!.classList.add('has-3d');
  document.querySelectorAll<HTMLElement>('.hero .w').forEach((w, i) => w.style.setProperty('--i', String(i)));

  /* Doodles qui se dessinent quand ils entrent à l'écran */
  const dio = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('drawn'); dio.unobserve(e.target); } }), { threshold: 0.3 });
  document.querySelectorAll('.doodle').forEach((d) => dio.observe(d));

  /* Énoncé : les mots s'allument */
  const stmt = document.querySelector<HTMLElement>('.reveal-words');
  if (stmt && !reduce) {
    const wrap = (node: Node) => {
      [...node.childNodes].forEach((n) => {
        if (n.nodeType === 3) {
          const frag = document.createDocumentFragment();
          n.textContent!.split(/(\s+)/).forEach((part) => {
            if (!part.trim()) { frag.appendChild(document.createTextNode(part)); return; }
            const s = document.createElement('span'); s.className = 'rw'; s.textContent = part; frag.appendChild(s);
          });
          n.replaceWith(frag);
        } else wrap(n);
      });
    };
    wrap(stmt);
    const words = [...stmt.querySelectorAll<HTMLElement>('.rw')];
    const onS = () => {
      const r = stmt.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (window.innerHeight * 0.85 - r.top) / (r.height + window.innerHeight * 0.3)));
      const lit = Math.floor(p * words.length);
      words.forEach((w, i) => w.classList.toggle('lit', i < lit));
    };
    window.addEventListener('scroll', onS, { passive: true }); onS();
  }

  /* Histoire : scène épinglée pilotée par le défilement (bureau) */
  const pin = document.querySelector<HTMLElement>('.story-pin');
  const tabs = [...document.querySelectorAll<HTMLElement>('.tabs li')];
  const chapters = [...document.querySelectorAll<HTMLElement>('.chapter')];
  const slots = [...document.querySelectorAll<HTMLElement>('.ui-slot')];
  const gains = [...document.querySelectorAll<HTMLElement>('.swipe-card .window-foot b')].map((b) => b.textContent);
  const savedVals = [0, 2, 6, 7.5];
  const gainEl = document.getElementById('gain');
  const savedEl = document.getElementById('saved');
  const fmtH = (v: number) => (Math.round(v * 10) / 10).toLocaleString('fr-CA') + ' h';
  let shown = 0, raf = 0;
  const countTo = (to: number) => {
    if (!savedEl) return;
    cancelAnimationFrame(raf);
    if (reduce) { shown = to; savedEl.textContent = fmtH(to); return; }
    const from = shown, t0 = performance.now();
    const tick = (t: number) => {
      const k = Math.min(1, (t - t0) / 700), e = 1 - Math.pow(1 - k, 3);
      shown = from + (to - from) * e; savedEl.textContent = fmtH(shown);
      if (k < 1) raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);
  };
  let current = 0;
  const setStep = (i: number) => {
    if (i === current) return;
    current = i;
    tabs.forEach((t, j) => { t.classList.toggle('is-active', j === i); t.classList.toggle('is-done', j < i); });
    chapters.forEach((c, j) => {
      c.classList.toggle('is-active', j === i);
      c.querySelectorAll('a').forEach((a) => (j === i ? a.removeAttribute('tabindex') : a.setAttribute('tabindex', '-1')));
    });
    slots.forEach((s, j) => s.classList.toggle('is-active', j === i));
    if (gainEl) { gainEl.classList.remove('pop'); void gainEl.offsetWidth; gainEl.textContent = gains[i] ?? ''; gainEl.classList.add('pop'); }
    countTo(savedVals[i] ?? 0);
  };
  const pinRange = () => {
    const top = pin!.getBoundingClientRect().top + window.scrollY;
    return { top, total: pin!.offsetHeight - window.innerHeight };
  };
  const onStory = () => {
    if (!pin || getComputedStyle(pin).display === 'none') return;
    const r = pin.getBoundingClientRect();
    const total = r.height - window.innerHeight;
    const p = Math.min(0.9999, Math.max(0, -r.top / total));
    const n = tabs.length;
    setStep(Math.floor(p * n));
    tabs.forEach((t, j) => t.style.setProperty('--fill', String(Math.min(1, Math.max(0, p * n - j)))));
  };
  const goTo = (i: number) => {
    if (!pin) return;
    const { top, total } = pinRange();
    const y = top + (total * (i + 0.5)) / tabs.length;
    lenis ? lenis.scrollTo(y, { duration: 0.9 }) : window.scrollTo({ top: y, behavior: reduce ? 'auto' : 'smooth' });
  };
  document.querySelectorAll<HTMLButtonElement>('[data-go]').forEach((b) => b.addEventListener('click', () => goTo(Number(b.dataset.go))));
  /* Flèches du clavier quand la scène est à l'écran */
  window.addEventListener('keydown', (e) => {
    if (!pin || getComputedStyle(pin).display === 'none' || !['ArrowDown', 'ArrowUp', 'ArrowRight', 'ArrowLeft'].includes(e.key)) return;
    const r = pin.getBoundingClientRect();
    if (r.top > 0 || r.bottom < window.innerHeight) return;
    const dir = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : -1;
    const next = current + dir;
    if (next < 0 || next >= tabs.length) return;
    e.preventDefault(); goTo(next);
  });
  /* Aimantation douce : quand on s'arrête entre deux étapes, on se cale sur la plus proche */
  if (lenis && pin) {
    let snapT = 0;
    lenis.on('scroll', () => {
      clearTimeout(snapT);
      snapT = window.setTimeout(() => {
        if (getComputedStyle(pin).display === 'none') return;
        const { top, total } = pinRange();
        const y = window.scrollY - top;
        if (y <= 0 || y >= total) return;
        const seg = total / tabs.length;
        const i = Math.min(tabs.length - 1, Math.floor(y / seg));
        const target = top + seg * (i + 0.5);
        if (Math.abs(window.scrollY - target) > seg * 0.06 && Math.abs(window.scrollY - target) < seg * 0.42) lenis!.scrollTo(target, { duration: 0.6 });
      }, 220);
    });
  }
  window.addEventListener('scroll', onStory, { passive: true }); onStory();

  /* Histoire mobile : carrousel */
  const track = document.getElementById('swipe');
  if (track) {
    const cards = [...track.querySelectorAll<HTMLElement>('.swipe-card')];
    const dots = [...document.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const prev = document.getElementById('swPrev') as HTMLButtonElement, next = document.getElementById('swNext') as HTMLButtonElement;
    let idx = 0;
    const setIdx = (i: number) => {
      idx = i;
      cards.forEach((c, j) => c.classList.toggle('is-active', j === i));
      dots.forEach((d, j) => d.classList.toggle('is-active', j === i));
      prev.disabled = i === 0; next.disabled = i === cards.length - 1;
    };
    const go = (i: number) => {
      const c = cards[Math.max(0, Math.min(cards.length - 1, i))];
      track.scrollTo({ left: c.offsetLeft - track.offsetLeft - 20, behavior: reduce ? 'auto' : 'smooth' });
    };
    const cio = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) setIdx(cards.indexOf(e.target as HTMLElement)); }), { root: track, threshold: 0.6 });
    cards.forEach((c) => cio.observe(c));
    dots.forEach((d) => d.addEventListener('click', () => go(Number(d.dataset.dot))));
    prev.addEventListener('click', () => go(idx - 1));
    next.addEventListener('click', () => go(idx + 1));
  }

  /* Apparition douce */
  const rio = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); rio.unobserve(e.target); } }), { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });
  document.querySelectorAll('.rv').forEach((el) => rio.observe(el));

  /* Barre de progression */
  const bar = document.getElementById('readProgress')!;
  const onProg = () => { const max = document.documentElement.scrollHeight - window.innerHeight; bar.style.setProperty('--p', String(max > 0 ? window.scrollY / max : 0)); };
  window.addEventListener('scroll', onProg, { passive: true }); onProg();

  /* Calculateur */
  const h = document.getElementById('h') as HTMLInputElement, r = document.getElementById('r') as HTMLInputElement;
  const upd = () => {
    const hh = Math.max(0, +h.value || 0), rr = Math.max(0, +r.value || 0);
    const yearly = hh * 52 * rr;
    document.getElementById('out')!.textContent = fmt(yearly) + ' $';
    document.getElementById('out2')!.textContent = `En automatisant 60 %, vous récupérez environ ${fmt(hh * 52 * 0.6)} heures et ${fmt(yearly * 0.6)} $.`;
  };
  [h, r].forEach((el) => el.addEventListener('input', upd));
  document.querySelectorAll<HTMLButtonElement>('.step').forEach((b) => b.addEventListener('click', () => {
    const el = b.dataset.t === 'h' ? h : r;
    el.value = String(Math.min(+el.max, Math.max(+el.min, (+el.value || 0) + Number(b.dataset.d))));
    upd();
  }));
  upd();

  /* Barre d'action mobile : visible après le hero, cachée près du CTA final */
  const mob = document.getElementById('mobileCta')!;
  const hero = document.querySelector('.hero')!, end = document.getElementById('rdv')!;
  let pastHero = false, atEnd = false;
  const refresh = () => mob.classList.toggle('show', pastHero && !atEnd);
  new IntersectionObserver(([e]) => { pastHero = !e.isIntersecting; refresh(); }).observe(hero);
  new IntersectionObserver(([e]) => { atEnd = e.isIntersecting; refresh(); }).observe(end);
</script>
