---
import Base from '../layouts/Base.astro';
import { bookingHref } from '../consts';
import { getPosts } from '../lib';
import '../styles/home.css';

const posts = (await getPosts()).slice(0, 3);

const tools = ['HubSpot', 'Pipedrive', 'Make', 'n8n', 'Zapier', 'Google Workspace', 'Microsoft 365', 'Slack', 'Asana', 'ClickUp', 'Monday', 'Notion', 'GA4', 'Google Ads', 'Meta Ads', 'Looker Studio', 'QuickBooks', 'PandaDoc'];

const steps = [
  {
    id: 'signature', time: 'Lundi · 9 h 02',
    title: 'Agence Boréal signe un nouveau client.',
    text: "Le contrat arrive signé. Personne n'a encore touché à rien, et c'est voulu.",
  },
  {
    id: 'accueil', time: 'Lundi · 9 h 02 min 41 s',
    title: 'Quarante et une secondes plus tard, tout est prêt.',
    text: "Fiche CRM, dossier partagé, projet, courriel de bienvenue, avis à l'équipe. Sans oubli, sans relance.",
  },
  {
    id: 'rapport', time: '1er du mois · 7 h 00',
    title: 'Les rapports clients sont déjà dans la boîte.',
    text: "Google Ads, GA4 et Meta réunis dans un rapport à vos couleurs. Il ne reste qu'à relire et envoyer.",
  },
  {
    id: 'soumission', time: 'Mardi · 14 h 10',
    title: 'Une demande de soumission arrive. Elle repart à 14 h 14.',
    text: 'La demande est captée, qualifiée et transformée en brouillon de soumission. Vous validez, le prospect reçoit sa réponse le jour même.',
  },
];

const UI: Record<string, string> = {
    signature: `
      <div class="ui-event"><span class="ui-badge">Déclencheur</span><b>Contrat signé</b><small>Agence Boréal × Clinique Dentaire Laval · PandaDoc</small></div>
      <div class="ui-wait"><span class="spin"></span>AxioPilot prend le relais…</div>`,
    accueil: `
      <ul class="ui-log">
        <li><span>9:02:06</span>Fiche client créée dans HubSpot<i>✓</i></li>
        <li><span>9:02:14</span>Dossier Drive « Clinique Dentaire Laval »<i>✓</i></li>
        <li><span>9:02:19</span>Projet Asana copié du gabarit<i>✓</i></li>
        <li><span>9:02:29</span>Courriel de bienvenue + questionnaire<i>✓</i></li>
        <li><span>9:02:41</span>Message dans #nouveaux-clients<i>✓</i></li>
      </ul>
      <div class="ui-total">5 tâches · 41 s · 0 erreur</div>`,
    rapport: `
      <div class="ui-report">
        <div class="ui-report-h"><b>Rapport d'octobre</b><span>Clinique Dentaire Laval</span></div>
        <div class="ui-kpis"><div><small>Clics</small><b>4 812</b><em>+18 %</em></div><div><small>Conversions</small><b>137</b><em>+22 %</em></div><div><small>Coût / conv.</small><b>21,40 $</b><em>−9 %</em></div></div>
        <svg viewBox="0 0 300 80" class="ui-spark"><polyline points="0,62 30,58 60,60 90,48 120,50 150,38 180,40 210,28 240,30 270,16 300,12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>`,
    soumission: `
      <div class="ui-quote">
        <div class="ui-quote-h"><b>Soumission #2026-114</b><span class="ui-badge ok">Envoyée 14 h 14</span></div>
        <div class="ui-row"><span>Refonte du site Web</span><span>✓</span></div>
        <div class="ui-row"><span>SEO local · 3 mois</span><span>✓</span></div>
        <div class="ui-row"><span>Campagne Google Ads</span><span>✓</span></div>
        <div class="ui-src">Source : formulaire du site · qualifiée « budget confirmé »</div>
      </div>`,
  };

const phases = [
  ['Jours 1 à 3', 'Diagnostic', "Un atelier de 90 minutes avec votre équipe. On cartographie le processus et on mesure le temps perdu."],
  ['Jours 4 à 17', 'Construction', "On bâtit l'automatisation sur vos outils et on la teste avec de vrais cas. Un point d'étape par semaine."],
  ['Jours 18 à 21', 'Mise en service', 'Lancement, formation de votre équipe et documentation en français.'],
  ['Mois 1 à 3', 'Suivi', 'Surveillance, ajustements et un bilan mensuel des heures récupérées.'],
];

const faqs = [
  ['Faut-il changer nos outils ?', "Non. On travaille avec ce que vous utilisez déjà : HubSpot, Pipedrive, Asana, ClickUp, Monday, Google Workspace, Microsoft 365, Slack et la plupart des outils courants en agence."],
  ["Qu'arrive-t-il aux données de nos clients ?", "Les données restent dans vos comptes. On documente chaque flux de renseignements personnels pour vous aider à respecter la Loi 25, et les accès sont retirés à la fin du mandat si vous le souhaitez."],
  ["Et si l'automatisation brise ?", "Les 3 mois de suivi sont faits pour ça : surveillance des erreurs, alertes et corrections. Votre équipe reçoit aussi une documentation simple pour comprendre ce qui roule."],
  ['Combien ça coûte ?', "Le Pack Sprint + Suivi est offert à prix fixe. On vous le confirme au premier appel, après avoir vu le processus à automatiser."],
  ['Vous faites aussi des sites et des interfaces ?', "Oui. Ce site en est un exemple. On conçoit aussi des portails clients, des tableaux de bord et des interfaces internes quand l'automatisation en a besoin."],
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
---
<Base jsonLd={faqLd}>

  <!-- ========== HERO ========== -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-stage" aria-hidden="true">
      <canvas id="hero3d"></canvas>
      <img class="hero-fallback" src="/logo-mark.png" alt="" width="222" height="154">
    </div>
    <div class="container hero-inner">
      <p class="eyebrow">Automatisation pour agences · Québec</p>
      <h1 id="hero-title" class="display">
        <span class="w">Votre</span> <span class="w">agence,</span><br>
        <span class="w">en</span> <span class="w accent">pilote</span><br>
        <span class="w accent">automatique.</span>
      </h1>
      <div class="hero-bottom">
        <p class="hero-lead">On automatise l'accueil des clients, les rapports et les soumissions des agences du Québec. Livré en 21 jours, sur les outils que vous utilisez déjà.</p>
        <div class="hero-ctas">
          <a class="btn btn-primary btn-lg" href={bookingHref}>Réserver un appel de 30 min</a>
          <a class="link-arrow" href="#histoire">Voir comment ça marche <span aria-hidden="true">↓</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== Outils ========== -->
  <section class="tools" aria-label="Outils compatibles">
    <p class="container tools-label">Branché sur les outils de votre agence</p>
    <div class="tools-row"><div class="tools-track">{[...tools, ...tools].map((t) => <span>{t}</span>)}</div></div>
  </section>

  <!-- ========== Énoncé ========== -->
  <section class="statement container">
    <p class="big-text reveal-words">Vos meilleurs talents passent des heures à créer des dossiers, assembler des rapports et relancer des clients. <span class="dim">On rend ces heures à votre équipe, pour qu'elle les passe sur ce qui fait grandir l'agence.</span></p>
  </section>

  <!-- ========== Histoire au défilement ========== -->
  <section class="story" id="histoire" aria-labelledby="story-title">
    <div class="container">
      <div class="story-head">
        <p class="eyebrow">Comment ça marche</p>
        <h2 id="story-title" class="h2">Une semaine chez Agence Boréal, en pilote automatique.</h2>
        <p class="note">Agence fictive. Le scénario, lui, est réel : c'est exactement ce qu'on met en place.</p>
      </div>

      <div class="story-grid">
        <ol class="story-steps">
          {steps.map((s, i) => (
            <li class="story-step" data-step={i}>
              <span class="step-time">{s.time}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              <div class="screen screen-inline" aria-hidden="true">
                <Fragment set:html={UI[s.id]} />
              </div>
            </li>
          ))}
        </ol>

        <div class="story-sticky" aria-hidden="true">
          <div class="screen">
            <div class="screen-bar"><i></i><i></i><i></i><span>axiopilot · journal d'exécution</span></div>
            <div class="screen-body">
              {steps.map((s, i) => (<div class={`ui-slot${i === 0 ? ' is-active' : ''}`} data-slot={i}><Fragment set:html={UI[s.id]} /></div>))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== Offre ========== -->
  <section class="offer container" id="offre" aria-labelledby="offer-title">
    <p class="eyebrow">L'offre · Pack Sprint + Suivi</p>
    <h2 id="offer-title" class="display-2">21 jours pour livrer.<br><span class="dim">3 mois pour que ça dure.</span></h2>
    <ol class="phases">
      {phases.map(([when, title, text]) => (
        <li><span class="ph-when">{when}</span><h3>{title}</h3><p>{text}</p></li>
      ))}
    </ol>
    <div class="offer-foot">
      <p>Un prix fixe, confirmé dès le premier appel. Pas de facturation à l'heure, pas de surprise.</p>
      <a class="btn btn-primary btn-lg" href={bookingHref}>Parler de votre processus</a>
    </div>
  </section>

  <!-- ========== Calculateur ========== -->
  <section class="calc container" aria-labelledby="calc-title">
    <p class="eyebrow">Faites le calcul</p>
    <h2 id="calc-title" class="sr-only">Combien vous coûtent les tâches répétitives</h2>
    <form class="madlib" id="madlib" onsubmit="return false">
      <p>
        Notre équipe passe
        <label class="fieldwrap"><span class="sr-only">Heures par semaine</span><input id="h" type="number" inputmode="numeric" min="1" max="80" value="8"><span>h</span></label>
        par semaine sur des tâches répétitives, à
        <label class="fieldwrap"><span class="sr-only">Coût horaire</span><input id="r" type="number" inputmode="numeric" min="15" max="250" step="5" value="55"><span>$</span></label>
        de l'heure.
      </p>
    </form>
    <div class="calc-result" aria-live="polite">
      <span class="calc-k">Ce que ça coûte par année</span>
      <span class="calc-num" id="out">22 880 $</span>
      <span class="calc-sub" id="out2">Si on en automatise 60 %, vous récupérez environ 250 heures et 13 728 $.</span>
    </div>
  </section>

  <!-- ========== Principes ========== -->
  <section class="principles container" aria-label="Notre façon de travailler">
    <div><h3>Vos outils, pas les nôtres.</h3><p>On construit sur ce que votre équipe connaît déjà. Pas de nouveau logiciel à apprendre.</p></div>
    <div><h3>Un seul interlocuteur.</h3><p>Vous parlez toujours à la personne qui construit, du diagnostic au suivi.</p></div>
    <div><h3>En français, à l'heure de l'Est.</h3><p>Documentation, formation et suivi en français, avec un respect documenté de la Loi 25.</p></div>
  </section>

  {posts.length > 0 && (
  <section class="journal container" id="blogue">
    <div class="journal-head"><p class="eyebrow">Blogue</p><a class="link-arrow" href="/blogue/">Tous les articles <span aria-hidden="true">→</span></a></div>
    <ul class="journal-list">
      {posts.map((p) => (
        <li><a href={`/blogue/${p.id}/`}><span class="j-cat">{p.data.category}</span><span class="j-title">{p.data.title}</span><span class="j-arrow" aria-hidden="true">→</span></a></li>
      ))}
    </ul>
  </section>
  )}

  <!-- ========== FAQ ========== -->
  <section class="faq2 container" id="faq" aria-labelledby="faq-title">
    <h2 id="faq-title" class="h2">Questions fréquentes</h2>
    <div class="faq-list">
      {faqs.map(([q, a]) => (<details><summary>{q}</summary><p>{a}</p></details>))}
    </div>
  </section>

  <!-- ========== CTA ========== -->
  <section class="cta-end" id="rdv">
    <div class="container">
      <p class="eyebrow">Prochaine étape</p>
      <h2 class="display-2">Trouvons les heures que votre agence perd.</h2>
      <p class="cta-lead">Un appel de 30 minutes, sans engagement. Vous repartez avec au moins une idée d'automatisation applicable, même si on ne travaille pas ensemble.</p>
      <a class="btn btn-primary btn-lg" href={bookingHref}>Choisir un moment</a>
    </div>
  </section>
</Base>

<script>
  import Lenis from 'lenis';
  import { initHero3D } from '../scripts/hero3d';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fmt = (n: number) => Math.round(n).toLocaleString('fr-CA');

  /* Défilement fluide */
  if (!reduce) {
    const lenis = new Lenis({ lerp: 0.11, wheelMultiplier: 1 });
    const raf = (t: number) => { lenis.raf(t); requestAnimationFrame(raf); };
    requestAnimationFrame(raf);
    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"], a[href^="/#"]').forEach((a) => {
      a.addEventListener('click', (e) => {
        const id = a.getAttribute('href')!.replace('/', '');
        const el = document.querySelector(id);
        if (el && location.pathname === '/') { e.preventDefault(); lenis.scrollTo(el as HTMLElement, { offset: -20 }); history.replaceState(null, '', id); }
      });
    });
  }

  /* 3D */
  const cv = document.getElementById('hero3d') as HTMLCanvasElement;
  if (cv && initHero3D(cv, { reduce })) document.querySelector('.hero')!.classList.add('has-3d');

  /* Titre : mots qui montent */
  document.querySelectorAll<HTMLElement>('.hero .w').forEach((w, i) => w.style.setProperty('--i', String(i)));

  /* Énoncé : les mots s'allument au défilement */
  const stmt = document.querySelector<HTMLElement>('.reveal-words');
  if (stmt && !reduce) {
    const wrap = (node: Node) => {
      [...node.childNodes].forEach((n) => {
        if (n.nodeType === 3) {
          const frag = document.createDocumentFragment();
          n.textContent!.split(/(\s+)/).forEach((part) => {
            if (!part.trim()) { frag.appendChild(document.createTextNode(part)); return; }
            const s = document.createElement('span'); s.className = 'rw'; s.textContent = part; frag.appendChild(s);
          });
          n.replaceWith(frag);
        } else wrap(n);
      });
    };
    wrap(stmt);
    const words = [...stmt.querySelectorAll<HTMLElement>('.rw')];
    const onS = () => {
      const r = stmt.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (window.innerHeight * 0.85 - r.top) / (r.height + window.innerHeight * 0.35)));
      const lit = Math.floor(p * words.length);
      words.forEach((w, i) => w.classList.toggle('lit', i < lit));
    };
    window.addEventListener('scroll', onS, { passive: true }); onS();
  }

  /* Écrans de l'histoire */

  const slots = [...document.querySelectorAll<HTMLElement>('.ui-slot')];
  const stepsEls = [...document.querySelectorAll<HTMLElement>('.story-step')];
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (!e.isIntersecting) return;
      const i = Number((e.target as HTMLElement).dataset.step);
      stepsEls.forEach((s, j) => s.classList.toggle('is-active', j === i));
      slots.forEach((s, j) => s.classList.toggle('is-active', j === i));
    });
  }, { rootMargin: '-45% 0px -45% 0px' });
  stepsEls.forEach((s) => io.observe(s));
  stepsEls[0]?.classList.add('is-active');

  /* Calculateur */
  const h = document.getElementById('h') as HTMLInputElement, r = document.getElementById('r') as HTMLInputElement;
  const upd = () => {
    const hh = Math.max(0, +h.value || 0), rr = Math.max(0, +r.value || 0);
    const yearly = hh * 52 * rr, saved = yearly * 0.6, hours = hh * 52 * 0.6;
    document.getElementById('out')!.textContent = fmt(yearly) + ' $';
    document.getElementById('out2')!.textContent = `Si on en automatise 60 %, vous récupérez environ ${fmt(hours)} heures et ${fmt(saved)} $.`;
  };
  [h, r].forEach((el) => el.addEventListener('input', upd)); upd();
</script>
